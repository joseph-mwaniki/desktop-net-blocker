<Window x:Class="DesktopNetBlocker.UI.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Net Blocker Overlay"
        Width="320" Height="175"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#E6121217"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Margin="6"
            Opacity="{Binding Opacity}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6" />
        </Border.Effect>

        <Grid Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Drag Handle / Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding RequestTypeTitle}"
                           FontWeight="Bold"
                           FontSize="10"
                           Foreground="#F87171" />
            </StackPanel>

            <!-- Target Domain -->
            <TextBlock Grid.Row="1"
                       Text="{Binding TargetDomain}"
                       FontWeight="SemiBold"
                       FontSize="13"
                       Foreground="#E5E7EB"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,2,0,4" />

            <!-- Dynamic Countdown Display -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding CountdownTimer}"
                           FontFamily="Consolas, Segoe UI Variable Display, Segoe UI"
                           FontWeight="Bold"
                           FontSize="22"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center" />
                <TextBlock Text="DAYS : HOURS : MINS : SECS"
                           FontSize="8"
                           FontWeight="Medium"
                           Foreground="#9CA3AF"
                           HorizontalAlignment="Center"
                           Margin="0,1,0,0" />
                <TextBlock Text="{Binding StageDescription}"
                           FontSize="8.5"
                           FontWeight="SemiBold"
                           Foreground="#60A5FA"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0" />
            </StackPanel>

            <!-- Cancel Button -->
            <Button Grid.Row="3"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource DangerButton}"
                    Padding="12,5"
                    Height="28"
                    FontSize="11"
                    HorizontalAlignment="Stretch"
                    Margin="0,4,0,0">
                <TextBlock Text="[CANCEL REQUEST]" FontWeight="Bold" />
            </Button>
        </Grid>
    </Border>
</Window>
